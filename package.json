{
  "name": "privacy-policy",
  "version": "1.2.0",
  "description": "Cuesoft Privacy Policy: markdown source, built into the brand template.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prebuild": "cuesoft-design-assets assets/design-system",
    "postbuild": "node scripts/check-dashes.mjs && node scripts/check-og-card.mjs && node scripts/check-not-found.mjs && node scripts/check-titles.mjs",
    "og": "node scripts/generate-og-image.mjs",
    "check:dashes": "node scripts/check-dashes.mjs",
    "check:design-system": "cuesoft-design-check corporate",
    "check:links": "node scripts/check-links.mjs",
    "check:og": "node scripts/check-og-card.mjs",
    "check:not-found": "node scripts/check-not-found.mjs",
    "check:titles": "node scripts/check-titles.mjs",
    "lint": "npm run check:design-system"
  },
  "dependencies": {
    "@cuesoftinc/design-system": "1.42.0",
    "@datadog/browser-rum": "7.14.0",
    "marked": "^14.1.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
