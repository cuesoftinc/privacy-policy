{
  "name": "privacy-policy",
  "version": "1.4.0",
  "description": "Cuesoft Privacy Policy: markdown source, built into the brand template.",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "prebuild": "cuesoft-design-assets assets/design-system",
    "postbuild": "node scripts/check-dashes.mjs && cuesoft-og-card --check && node scripts/check-not-found.mjs && node scripts/check-titles.mjs && node scripts/check-descriptions.mjs",
    "og": "cuesoft-og-card",
    "check:dashes": "node scripts/check-dashes.mjs",
    "check:descriptions": "node scripts/check-descriptions.mjs",
    "check:design-system": "cuesoft-design-check corporate",
    "check:links": "node scripts/check-links.mjs",
    "check:og": "cuesoft-og-card --check",
    "check:not-found": "node scripts/check-not-found.mjs",
    "check:titles": "node scripts/check-titles.mjs",
    "lint": "npm run check:design-system",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown"
  },
  "dependencies": {
    "@cuesoftinc/design-system": "1.71.0",
    "@datadog/browser-rum": "7.14.0",
    "marked": "^14.1.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "3.9.9"
  }
}
